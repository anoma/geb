module

public import Mathlib.Data.FinEnum

set_option doc.verso true in
/-!
# Finite choice and congruence in finitely many arguments

Finitely many existence statements have a common witness function, constructed by recursion
on an enumeration ({lit}`exists_forall_of_finEnum`). A function of finitely many arguments
respects the equivalence relations generated by relations on its arguments when it relates
its values at two argument families that differ in one argument, related there
({lit}`eqvGen_of_update`): the arguments are replaced one at a time along an enumeration.
Both are the steps by which a quotient by a generated equivalence relation receives the
operations of a finitary signature, one class chosen per argument.

## Main definitions

* {lit}`finEnumBool`, {lit}`finEnumPEmpty`, {lit}`finEnumPUnit` — enumerations of the
  booleans, the empty type and the one-element type.

## Main statements

* {lit}`exists_forall_of_finEnum` — finitely many choices, constructively.
* {lit}`update_update`, {lit}`update_apply_self`, {lit}`update_apply_of` — laws of
  {name}`Function.update`.
* {lit}`eqvGen_update`, {lit}`eqvGen_of_update` — congruence in one argument and in all.

## Implementation notes

The finiteness of the arguments is an enumeration, {name}`FinEnum`, whose list the choices
recurse on. mathlib's {lit}`Quotient.finChoice` for a {name}`Fintype` depends on
{lit}`Classical.choice`, as do {name}`Function.update_idem` and {name}`Function.update_eq_self`
and mathlib's enumerations of {name}`Fin`; the two lemmas on {name}`Function.update` are
reproved here, and the enumerations of the booleans, the empty type and the one-element type are
given directly.

## Tags

finite choice, enumeration, equivalence relation, congruence
-/

set_option doc.verso true

@[expose] public section

namespace GebProto

universe u v w

/-- The booleans, enumerated without {lit}`Classical.choice`, on which mathlib's
enumerations of {name}`Fin` depend. -/
@[instance_reducible] def finEnumBool : FinEnum Bool where
  card := 2
  equiv :=
    { toFun b := cond b 1 0
      invFun i := Fin.cases false (fun _ ↦ true) i
      left_inv b := by cases b <;> rfl
      right_inv i := Fin.cases rfl (fun j ↦ Fin.cases rfl (fun k ↦ k.elim0) j) i }
  decEq := inferInstance

/-- The empty type, enumerated without {lit}`Classical.choice`. -/
@[instance_reducible] def finEnumPEmpty : FinEnum PEmpty.{u + 1} where
  card := 0
  equiv := ⟨(fun x ↦ nomatch x), Fin.elim0, (fun x ↦ nomatch x), (fun i ↦ i.elim0)⟩
  decEq x := nomatch x

/-- The one-element type, enumerated without {lit}`Classical.choice`. -/
@[instance_reducible] def finEnumPUnit : FinEnum PUnit.{u + 1} where
  card := 1
  equiv := ⟨fun _ ↦ 0, fun _ ↦ ⟨⟩, fun _ ↦ rfl, fun i ↦ Fin.cases rfl (fun k ↦ k.elim0) i⟩
  decEq _ _ := .isTrue rfl

/-- Finitely many existence statements have a common witness function: the choice of
finitely many elements, constructive by recursion on an enumeration. -/
theorem exists_forall_of_finEnum {ι : Type u} [FinEnum ι] {α : ι → Sort v}
    {p : (i : ι) → α i → Prop} (h : ∀ i, ∃ x, p i x) : ∃ f : (i : ι) → α i, ∀ i, p i (f i) := by
  have key : ∀ l : List ι, ∃ f : (i : ι) → i ∈ l → α i, ∀ i (hi : i ∈ l), p i (f i hi) :=
    List.rec ⟨(fun _ hi ↦ nomatch hi), (fun _ hi ↦ nomatch hi)⟩ fun i₀ l ih ↦ by
      obtain ⟨x₀, hx₀⟩ := h i₀
      obtain ⟨f, hf⟩ := ih
      refine ⟨fun i hi ↦ if hii : i = i₀ then hii ▸ x₀ else f i (List.mem_of_ne_of_mem hii hi),
        fun i hi ↦ ?_⟩
      dsimp only
      split
      · rename_i hii
        subst hii
        exact hx₀
      · exact hf i _
  obtain ⟨f, hf⟩ := key (FinEnum.toList ι)
  exact ⟨fun i ↦ f i (FinEnum.mem_toList i), fun i ↦ hf i _⟩

/-- Updating a function twice at one point is updating it once with the second
value. -/
theorem update_update {ι : Type u} [DecidableEq ι] {α : ι → Sort v} (f : (i : ι) → α i)
    (i : ι) (x y : α i) : Function.update (Function.update f i x) i y = Function.update f i y := by
  funext j
  by_cases hj : j = i
  · subst hj
    rw [Function.update_self, Function.update_self]
  · rw [Function.update_of_ne hj, Function.update_of_ne hj, Function.update_of_ne hj]

/-- Updating a function at a point with its own value there leaves it. -/
theorem update_apply_self {ι : Type u} [DecidableEq ι] {α : ι → Sort v} (f : (i : ι) → α i)
    (i : ι) : Function.update f i (f i) = f := by
  funext j
  by_cases hj : j = i
  · subst hj
    exact Function.update_self _ _ _
  · exact Function.update_of_ne hj _ _

/-- A property holding of the new value at the updated point and of the old values elsewhere
holds of every value of the update. -/
theorem update_apply_of {ι : Type u} [DecidableEq ι] {α : ι → Sort v} (P : (i : ι) → α i → Prop)
    (f : (i : ι) → α i) (i : ι) (x : α i) (hx : P i x) (hf : ∀ j, j ≠ i → P j (f j)) (j : ι) :
    P j (Function.update f i x j) := by
  by_cases hj : j = i
  · subst hj
    rw [Function.update_self]
    exact hx
  · rw [Function.update_of_ne hj]
    exact hf j hj

section Congruence

variable {ι : Type u} [DecidableEq ι] {α : ι → Type v} {β : Type w}
  {r : (i : ι) → α i → α i → Prop} {R : β → β → Prop} (f : ((i : ι) → α i) → β)

/-- A function that relates its values before and after replacing one argument by a related
one respects, in each argument, the equivalence relations generated. -/
theorem eqvGen_update (hf : ∀ g i y, r i (g i) y → R (f g) (f (Function.update g i y)))
    (g : (i : ι) → α i) (i : ι) {x y : α i} (hxy : Relation.EqvGen (r i) x y) :
    Relation.EqvGen R (f (Function.update g i x)) (f (Function.update g i y)) := by
  refine Relation.EqvGen.rec (motive := fun x y _ ↦
      Relation.EqvGen R (f (Function.update g i x)) (f (Function.update g i y)))
    (fun x y hr ↦ ?_) (fun _ ↦ .refl _) (fun _ _ _ ih ↦ .symm _ _ ih)
    (fun _ _ _ _ _ ih₁ ih₂ ↦ .trans _ _ _ ih₁ ih₂) hxy
  have h := hf (Function.update g i x) i y ((Function.update_self i x g).symm ▸ hr)
  rw [update_update] at h
  exact .rel _ _ h

/-- A function of finitely many arguments that relates its values before and after replacing
one argument by a related one respects the equivalence relations generated: arguments related
in every place give related values, the arguments being replaced one at a time along an
enumeration. -/
theorem eqvGen_of_update [FinEnum ι]
    (hf : ∀ g i y, r i (g i) y → R (f g) (f (Function.update g i y)))
    {g g' : (i : ι) → α i} (h : ∀ i, Relation.EqvGen (r i) (g i) (g' i)) :
    Relation.EqvGen R (f g) (f g') := by
  let k : List ι → (i : ι) → α i := List.foldr (fun i₀ k ↦ Function.update k i₀ (g' i₀)) g
  have hk : ∀ l i, k l i = g i ∨ k l i = g' i :=
    List.rec (fun _ ↦ .inl rfl) fun i₀ l ih i ↦ by
      change Function.update (k l) i₀ (g' i₀) i = g i ∨ Function.update (k l) i₀ (g' i₀) i = g' i
      by_cases hi : i = i₀
      · subst hi
        rw [Function.update_self]
        exact .inr rfl
      · rw [Function.update_of_ne hi]
        exact ih i
  have hmem : ∀ l i, i ∈ l → k l i = g' i :=
    List.rec (fun _ hi ↦ nomatch hi) fun i₀ l ih i hi ↦ by
      change Function.update (k l) i₀ (g' i₀) i = g' i
      by_cases hii : i = i₀
      · subst hii
        exact Function.update_self _ _ _
      · rw [Function.update_of_ne hii]
        exact ih i (List.mem_of_ne_of_mem hii hi)
  have hstep : ∀ l, Relation.EqvGen R (f g) (f (k l)) :=
    List.rec (.refl _) fun i₀ l ih ↦ by
      refine .trans _ _ _ ih ?_
      have hi₀ : Relation.EqvGen (r i₀) (k l i₀) (g' i₀) :=
        (hk l i₀).elim (fun he ↦ he ▸ h i₀) (fun he ↦ he ▸ .refl _)
      have := eqvGen_update f hf (k l) i₀ hi₀
      rwa [update_apply_self] at this
  have hfin : k (FinEnum.toList ι) = g' := funext fun i ↦ hmem _ i (FinEnum.mem_toList i)
  exact hfin ▸ hstep _

end Congruence

end GebProto

end
