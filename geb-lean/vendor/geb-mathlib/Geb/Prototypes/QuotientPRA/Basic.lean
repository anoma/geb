set_option doc.verso true in
/-!
# Proof-relevant relations in a presheaf category and their quotients

A presheaf on the product {lit}`I × WalkingParallelPair` is a presheaf on {lit}`I`
of terms, its value at {lit}`(i, zero)`, together with a presheaf on {lit}`I` of
witnesses, its value at {lit}`(i, one)`, and two morphisms of presheaves from the
witnesses to the terms, the restrictions along the two parallel morphisms
{lit}`zero ⟶ one`. It is a proof-relevant relation, or directed multigraph, internal
to the presheaves on {lit}`I`: a witness relates its source to its target, and
restricting a witness along a morphism of {lit}`I` relates the restrictions of its
endpoints.

The quotient of such a graph is its coequalizer, computed at each object of
{lit}`I` as a {name}`Function.Coequalizer`, a {name}`Quot` of the terms by the
relation "some witness has these endpoints". Restriction descends to the quotient
because it acts on witnesses. The quotient is left adjoint to the discrete-graph
functor, which sends a presheaf {lit}`P` on {lit}`I` to the graph whose terms and
witnesses are both {lit}`P` and whose endpoint maps are identities, the
precomposition of {lit}`P` with the projection {lit}`I × WalkingParallelPair ⥤ I`.
The adjunction is {lit}`coeqHomEquiv`: morphisms from the quotient of {lit}`X` to
{lit}`P` correspond to morphisms from {lit}`X` to the discrete graph on {lit}`P`,
that is, to morphisms of the terms that equate the two endpoints of every witness.

## Main definitions

* {lit}`termObj`, {lit}`eqObj` — the objects of terms and of witnesses over an
  object of {lit}`I`.
* {lit}`srcHom`, {lit}`tgtHom`, {lit}`termHom`, {lit}`eqHom` — the generating
  morphisms of {lit}`I × WalkingParallelPair`; {lit}`endHom` — the endpoint morphism
  of the walking parallel pair at an orientation.
* {lit}`src`, {lit}`tgt`, {lit}`restr`, {lit}`restrEq` — their actions on a graph.
* {lit}`coeq` — the quotient presheaf of a graph, and {lit}`coeqMk` its quotient map.
* {lit}`discrete` — the discrete graph on a presheaf on {lit}`I`, and
  {lit}`discreteMap` on a morphism of presheaves.
* {lit}`coeqUnit` — the quotient map as a morphism of graphs into the discrete
  graph on the quotient.
* {lit}`coeqDesc` — the morphism out of the quotient induced by a morphism into a
  discrete graph.
* {lit}`coeqHomEquiv` — the adjunction between the quotient and the discrete graph.

## Main statements

* {lit}`src_restrEq`, {lit}`tgt_restrEq` — the endpoint maps commute with
  restriction.
* {lit}`coeqMk_src` — the two endpoints of a witness have the same class.
* {lit}`coeqMk_eq_iff` — two terms have the same class exactly when the equivalence
  relation generated by the witnesses relates them.
* {lit}`discreteMap_coeqDesc_unit` — the discrete graph on {lit}`coeqDesc γ`, after the
  unit, is {lit}`γ`.

## Implementation notes

The functors are built as {name}`CategoryTheory.Functor` values with explicit
fields rather than by composing mathlib's functors: mathlib's
{name}`CategoryTheory.Functor.comp` depends on {lit}`Classical.choice`, and the
discrete graph written as a composite would inherit that dependency.

A naturality square of {lit}`I × WalkingParallelPair` is checked by cases on the
{name}`CategoryTheory.Limits.WalkingParallelPairHom` component of the morphism: an
identity at the terms, an identity at the witnesses, or one of the two endpoint
morphisms.

## References

* \[nLabCoequalizer\]
* \[AltenkirchCapriottiDijkstraKrausNordvallForsberg2018\]

## Tags

quotient, coequalizer, presheaf, proof-relevant relation, graph, adjunction
-/

set_option doc.verso true

@[expose] public section

open CategoryTheory Limits

namespace GebProto.QuotientPRA

universe uI vI w u v

variable {I : Type uI} [Category.{vI} I]

/-- The object of terms over {lit}`i`. -/
abbrev termObj (i : I) : I × WalkingParallelPair := (i, .zero)

/-- The object of witnesses over {lit}`i`. -/
abbrev eqObj (i : I) : I × WalkingParallelPair := (i, .one)

/-- The morphism along which a witness restricts to its source. -/
def srcHom (i : I) : termObj i ⟶ eqObj i := (𝟙 i, WalkingParallelPairHom.left)

/-- The morphism along which a witness restricts to its target. -/
def tgtHom (i : I) : termObj i ⟶ eqObj i := (𝟙 i, WalkingParallelPairHom.right)

/-- The endpoint morphism of the walking parallel pair at an orientation: the source
for {lit}`false`, the target for {lit}`true`. -/
def endHom : Bool → (WalkingParallelPair.zero ⟶ WalkingParallelPair.one)
  | false => WalkingParallelPairHom.left
  | true => WalkingParallelPairHom.right

/-- A morphism of {lit}`I` acting on terms. -/
def termHom {i' i : I} (f : i' ⟶ i) : termObj i' ⟶ termObj i := (f, 𝟙 _)

/-- A morphism of {lit}`I` acting on witnesses. -/
def eqHom {i' i : I} (f : i' ⟶ i) : eqObj i' ⟶ eqObj i := (f, 𝟙 _)

/-- The morphism along which a witness over {lit}`i` restricts to the restriction of
its source along {lit}`f`. -/
def srcOver {i' i : I} (f : i' ⟶ i) : termObj i' ⟶ eqObj i := (f, WalkingParallelPairHom.left)

/-- The morphism along which a witness over {lit}`i` restricts to the restriction of
its target along {lit}`f`. -/
def tgtOver {i' i : I} (f : i' ⟶ i) : termObj i' ⟶ eqObj i := (f, WalkingParallelPairHom.right)

/-- Restricting a witness and then taking its source is taking its source and then
restricting it. -/
theorem srcHom_comp_eqHom {i' i : I} (f : i' ⟶ i) :
    srcHom i' ≫ eqHom f = termHom f ≫ srcHom i := by
  change ((𝟙 i' ≫ f, WalkingParallelPairHom.left ≫ 𝟙 _) : termObj i' ⟶ eqObj i) =
    (f ≫ 𝟙 i, 𝟙 _ ≫ WalkingParallelPairHom.left)
  rw [Category.id_comp, Category.comp_id, Category.comp_id, Category.id_comp]

/-- Restricting a witness and then taking its target is taking its target and then
restricting it. -/
theorem tgtHom_comp_eqHom {i' i : I} (f : i' ⟶ i) :
    tgtHom i' ≫ eqHom f = termHom f ≫ tgtHom i := by
  change ((𝟙 i' ≫ f, WalkingParallelPairHom.right ≫ 𝟙 _) : termObj i' ⟶ eqObj i) =
    (f ≫ 𝟙 i, 𝟙 _ ≫ WalkingParallelPairHom.right)
  rw [Category.id_comp, Category.comp_id, Category.comp_id, Category.id_comp]

/-- Restricting a term along {lit}`f` and then taking it as a source is restricting
along {lit}`srcOver f`. -/
theorem termHom_comp_srcHom {i' i : I} (f : i' ⟶ i) : termHom f ≫ srcHom i = srcOver f := by
  change ((f ≫ 𝟙 i, 𝟙 _ ≫ WalkingParallelPairHom.left) : termObj i' ⟶ eqObj i) = _
  rw [Category.comp_id, Category.id_comp]
  rfl

/-- Restricting a term along {lit}`f` and then taking it as a target is restricting
along {lit}`tgtOver f`. -/
theorem termHom_comp_tgtHom {i' i : I} (f : i' ⟶ i) : termHom f ≫ tgtHom i = tgtOver f := by
  change ((f ≫ 𝟙 i, 𝟙 _ ≫ WalkingParallelPairHom.right) : termObj i' ⟶ eqObj i) = _
  rw [Category.comp_id, Category.id_comp]
  rfl

/-- Naturality of a transformation between presheaves of types, at an element. -/
theorem naturality_apply {C : Type u} [Category.{v} C] {F G : C ⥤ Type w} (α : NatTrans F G)
    {c c' : C} (g : c ⟶ c') (x : F.obj c) : α.app c' (F.map g x) = G.map g (α.app c x) :=
  FunctorToTypes.naturality _ _ α g x

section Graph

variable (X : (I × WalkingParallelPair)ᵒᵖ ⥤ Type w)

/-- The source of a witness. -/
def src (i : I) : X.obj ⟨eqObj i⟩ → X.obj ⟨termObj i⟩ := X.map (srcHom i).op

/-- The target of a witness. -/
def tgt (i : I) : X.obj ⟨eqObj i⟩ → X.obj ⟨termObj i⟩ := X.map (tgtHom i).op

/-- The restriction of a term along a morphism of {lit}`I`. -/
def restr {i' i : I} (f : i' ⟶ i) : X.obj ⟨termObj i⟩ → X.obj ⟨termObj i'⟩ :=
  X.map (termHom f).op

/-- The restriction of a witness along a morphism of {lit}`I`. -/
def restrEq {i' i : I} (f : i' ⟶ i) : X.obj ⟨eqObj i⟩ → X.obj ⟨eqObj i'⟩ :=
  X.map (eqHom f).op

/-- The source of a restricted witness is the restriction of its source. -/
theorem src_restrEq {i' i : I} (f : i' ⟶ i) (e : X.obj ⟨eqObj i⟩) :
    src X i' (restrEq X f e) = restr X f (src X i e) := by
  simp only [src, restrEq, restr]
  rw [← FunctorToTypes.map_comp_apply, ← FunctorToTypes.map_comp_apply, ← op_comp, ← op_comp,
    srcHom_comp_eqHom]

/-- The target of a restricted witness is the restriction of its target. -/
theorem tgt_restrEq {i' i : I} (f : i' ⟶ i) (e : X.obj ⟨eqObj i⟩) :
    tgt X i' (restrEq X f e) = restr X f (tgt X i e) := by
  simp only [tgt, restrEq, restr]
  rw [← FunctorToTypes.map_comp_apply, ← FunctorToTypes.map_comp_apply, ← op_comp, ← op_comp,
    tgtHom_comp_eqHom]

/-- The restriction of a term along the composite of two morphisms of {lit}`I` is the
composite of the restrictions. -/
theorem restr_comp {i'' i' i : I} (g : i'' ⟶ i') (f : i' ⟶ i) (t : X.obj ⟨termObj i⟩) :
    restr X (g ≫ f) t = restr X g (restr X f t) := by
  simp only [restr]
  rw [← FunctorToTypes.map_comp_apply, ← op_comp]
  congr 2

/-- The restriction of a term along an identity is the term. -/
theorem restr_id (i : I) (t : X.obj ⟨termObj i⟩) : restr X (𝟙 i) t = t :=
  FunctorToTypes.map_id_apply X t

/-- Restricting a witness's source along {lit}`f` is restricting the witness along the
morphism {lit}`srcOver f`. -/
theorem restr_src {i' i : I} (f : i' ⟶ i) (e : X.obj ⟨eqObj i⟩) :
    restr X f (src X i e) = X.map (srcOver f).op e := by
  simp only [restr, src]
  rw [← FunctorToTypes.map_comp_apply, ← op_comp, termHom_comp_srcHom]

/-- Restricting a witness's target along {lit}`f` is restricting the witness along the
morphism {lit}`tgtOver f`. -/
theorem restr_tgt {i' i : I} (f : i' ⟶ i) (e : X.obj ⟨eqObj i⟩) :
    restr X f (tgt X i e) = X.map (tgtOver f).op e := by
  simp only [restr, tgt]
  rw [← FunctorToTypes.map_comp_apply, ← op_comp, termHom_comp_tgtHom]

end Graph

section Coeq

variable (X : (I × WalkingParallelPair)ᵒᵖ ⥤ Type w)

/-- The quotient of the terms over {lit}`i` by the witnesses over {lit}`i`. -/
abbrev Coeq (i : I) : Type w := Function.Coequalizer (src X i) (tgt X i)

/-- The class of a term. -/
abbrev coeqMk {i : I} (t : X.obj ⟨termObj i⟩) : Coeq X i := Function.Coequalizer.mk _ _ t

/-- The two endpoints of a witness have the same class. -/
theorem coeqMk_src {i : I} (e : X.obj ⟨eqObj i⟩) : coeqMk X (src X i e) = coeqMk X (tgt X i e) :=
  Function.Coequalizer.condition _ _ e

/-- Two terms have the same class exactly when they are related by the equivalence
relation generated by the witnesses. -/
theorem coeqMk_eq_iff {i : I} (t t' : X.obj ⟨termObj i⟩) :
    coeqMk X t = coeqMk X t' ↔
      Relation.EqvGen (Function.Coequalizer.Rel (src X i) (tgt X i)) t t' :=
  ⟨Quot.eqvGen_exact, Quot.eqvGen_sound⟩

/-- The action of a morphism of {lit}`I` on classes: restrict a representative. -/
def coeqMap {i' i : I} (f : i' ⟶ i) : Coeq X i → Coeq X i' :=
  Function.Coequalizer.desc _ _ (coeqMk X ∘ restr X f) <| funext fun e ↦ by
    change coeqMk X (restr X f (src X i e)) = coeqMk X (restr X f (tgt X i e))
    rw [← src_restrEq, ← tgt_restrEq]
    exact coeqMk_src X _

/-- The quotient of a graph: the presheaf on {lit}`I` whose value at {lit}`i` is the
coequalizer of the endpoint maps at {lit}`i`. -/
def coeq : Iᵒᵖ ⥤ Type w where
  obj i := Coeq X i.unop
  map f := ↾ coeqMap X f.unop
  map_id i := by
    ext q
    change coeqMap X (𝟙 i.unop) q = q
    exact Quot.ind (β := fun q ↦ coeqMap X (𝟙 i.unop) q = q)
      (fun t ↦ congrArg (coeqMk X) (restr_id X i.unop t)) q
  map_comp f g := by
    ext q
    change coeqMap X (g.unop ≫ f.unop) q = coeqMap X g.unop (coeqMap X f.unop q)
    exact Quot.ind
      (β := fun q ↦ coeqMap X (g.unop ≫ f.unop) q = coeqMap X g.unop (coeqMap X f.unop q))
      (fun t ↦ congrArg (coeqMk X) (restr_comp X g.unop f.unop t)) q

end Coeq

section Discrete

/-- The discrete graph on a presheaf {lit}`P` on {lit}`I`: its terms and witnesses
over {lit}`i` are both {lit}`P.obj i`, and its endpoint maps are identities. It is the
precomposition of {lit}`P` with the projection {lit}`I × WalkingParallelPair ⥤ I`. -/
def discrete (P : Iᵒᵖ ⥤ Type w) : (I × WalkingParallelPair)ᵒᵖ ⥤ Type w where
  obj c := P.obj ⟨c.unop.1⟩
  map g := P.map g.unop.1.op
  map_id c := P.map_id ⟨c.unop.1⟩
  map_comp g h := P.map_comp g.unop.1.op h.unop.1.op

/-- The source map of a discrete graph is the identity. -/
theorem src_discrete (P : Iᵒᵖ ⥤ Type w) (i : I) (e : P.obj ⟨i⟩) : src (discrete P) i e = e :=
  FunctorToTypes.map_id_apply P e

/-- The target map of a discrete graph is the identity. -/
theorem tgt_discrete (P : Iᵒᵖ ⥤ Type w) (i : I) (e : P.obj ⟨i⟩) : tgt (discrete P) i e = e :=
  FunctorToTypes.map_id_apply P e

/-- The discrete graph on a morphism of presheaves on {lit}`I`: its component at an
object is the component at the object's {lit}`I` component. -/
def discreteMap {P P' : Iᵒᵖ ⥤ Type w} (h : NatTrans P P') :
    NatTrans (discrete P) (discrete P') where
  app c := h.app ⟨c.unop.1⟩
  naturality _ _ g := h.naturality g.unop.1.op

end Discrete

section Adjunction

variable (X : (I × WalkingParallelPair)ᵒᵖ ⥤ Type w)

/-- The components of the unit: a term goes to its class, and a witness to the class
of its source. -/
def coeqUnitApp : (c : (I × WalkingParallelPair)ᵒᵖ) → X.obj c → (discrete (coeq X)).obj c
  | ⟨(_, .zero)⟩ => coeqMk X
  | ⟨(i, .one)⟩ => coeqMk X ∘ src X i

/-- The unit commutes with the restriction along every morphism of
{lit}`I × WalkingParallelPair`, by cases on its {lit}`WalkingParallelPair` component. -/
theorem coeqUnitApp_map {i' i : I} {x' x : WalkingParallelPair} (f : i' ⟶ i) (h : x' ⟶ x)
    (t : X.obj ⟨(i, x)⟩) :
    coeqUnitApp X ⟨(i', x')⟩ (X.map (Quiver.Hom.op (X := (i', x')) (Y := (i, x)) (f, h)) t) =
      coeqMap X f (coeqUnitApp X ⟨(i, x)⟩ t) := by
  cases h with
  | id =>
    cases x' with
    | zero => rfl
    | one => exact congrArg (coeqMk X) (src_restrEq X f t)
  | left => exact congrArg (coeqMk X) (restr_src X f t).symm
  | right =>
    refine (congrArg (coeqMk X) (restr_tgt X f t).symm).trans ?_
    change coeqMk X (restr X f (tgt X i t)) = coeqMk X (restr X f (src X i t))
    rw [← src_restrEq, ← tgt_restrEq]
    exact (coeqMk_src X _).symm

/-- The unit of the adjunction: the quotient map, as a morphism from a graph to the
discrete graph on its quotient. -/
def coeqUnit : NatTrans X (discrete (coeq X)) where
  app c := ↾ coeqUnitApp X c
  naturality c c' g := by
    obtain ⟨⟨i, x⟩⟩ := c
    obtain ⟨⟨i', x'⟩⟩ := c'
    obtain ⟨⟨f, h⟩⟩ := g
    ext t
    exact coeqUnitApp_map X f h t

variable {X}

/-- A morphism into a discrete graph equates the two endpoints of every witness. -/
theorem app_src_eq_app_tgt {P : Iᵒᵖ ⥤ Type w} (γ : NatTrans X (discrete P)) {i : I}
    (e : X.obj ⟨eqObj i⟩) : γ.app ⟨termObj i⟩ (src X i e) = γ.app ⟨termObj i⟩ (tgt X i e) :=
  ((naturality_apply γ (srcHom i).op e).trans (src_discrete P i _)).trans
    ((naturality_apply γ (tgtHom i).op e).trans (tgt_discrete P i _)).symm

/-- The components of {lit}`coeqDesc`: the class of a term goes to the term's image. -/
def coeqDescApp {P : Iᵒᵖ ⥤ Type w} (γ : NatTrans X (discrete P)) (i : I) :
    Coeq X i → P.obj ⟨i⟩ :=
  Function.Coequalizer.desc _ _ (γ.app ⟨termObj i⟩) (funext fun e ↦ app_src_eq_app_tgt γ e)

/-- The morphism out of the quotient induced by a morphism into a discrete graph: its
component at {lit}`i` sends the class of a term to the term's image. -/
def coeqDesc {P : Iᵒᵖ ⥤ Type w} (γ : NatTrans X (discrete P)) : NatTrans (coeq X) P where
  app i := ↾ coeqDescApp γ i.unop
  naturality i i' f := by
    ext q
    change coeqDescApp γ i'.unop (coeqMap X f.unop q) = P.map f (coeqDescApp γ i.unop q)
    exact Quot.ind (β := fun q ↦
        coeqDescApp γ i'.unop (coeqMap X f.unop q) = P.map f (coeqDescApp γ i.unop q))
      (fun t ↦ naturality_apply γ (termHom f.unop).op t) q

/-- The value of {lit}`coeqDesc` on the class of a term. -/
@[simp]
theorem coeqDesc_app_mk {P : Iᵒᵖ ⥤ Type w} (γ : NatTrans X (discrete P)) {i : I}
    (t : X.obj ⟨termObj i⟩) : (coeqDesc γ).app ⟨i⟩ (coeqMk X t) = γ.app ⟨termObj i⟩ t :=
  rfl

/-- The image of a morphism out of the quotient under the discrete-graph functor,
precomposed with the unit. -/
def coeqHomToFun {P : Iᵒᵖ ⥤ Type w} (β : NatTrans (coeq X) P) : NatTrans X (discrete P) where
  app c := ↾ fun t ↦ β.app ⟨c.unop.1⟩ (coeqUnitApp X c t)
  naturality c c' g := by
    obtain ⟨⟨i, x⟩⟩ := c
    obtain ⟨⟨i', x'⟩⟩ := c'
    obtain ⟨⟨f, h⟩⟩ := g
    ext t
    exact (congrArg (β.app ⟨i'⟩) (coeqUnitApp_map X f h t)).trans
      (naturality_apply β f.op _)

/-- The quotient is left adjoint to the discrete graph: morphisms from the quotient
of {lit}`X` to {lit}`P` correspond to morphisms from {lit}`X` to the discrete graph on
{lit}`P`. -/
def coeqHomEquiv (P : Iᵒᵖ ⥤ Type w) : NatTrans (coeq X) P ≃ NatTrans X (discrete P) where
  toFun := coeqHomToFun
  invFun := coeqDesc
  left_inv β := by
    ext i q
    exact Quot.ind (β := fun q ↦ (coeqDesc (coeqHomToFun β)).app i q = β.app i q)
      (fun _ ↦ rfl) q
  right_inv γ := by
    ext ⟨⟨i, x⟩⟩ t
    cases x with
    | zero => rfl
    | one =>
      change γ.app ⟨termObj i⟩ (src X i t) = γ.app ⟨eqObj i⟩ t
      exact (naturality_apply γ (srcHom i).op t).trans (src_discrete P i _)

/-- The discrete graph on {lit}`coeqDesc γ`, precomposed with the unit, is {lit}`γ`. -/
theorem discreteMap_coeqDesc_unit {P : Iᵒᵖ ⥤ Type w} (γ : NatTrans X (discrete P))
    (c : (I × WalkingParallelPair)ᵒᵖ) (t : X.obj c) :
    (discreteMap (coeqDesc γ)).app c ((coeqUnit X).app c t) = γ.app c t :=
  congrArg (fun δ : NatTrans X (discrete P) ↦ δ.app c t) ((coeqHomEquiv P).right_inv γ)

end Adjunction

end GebProto.QuotientPRA
